{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "*.json",
      "*.ts",
      "!package-lock.json",
      "!next-env.d.ts",
      "tests/**/*.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
