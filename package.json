{
  "name": "farzine-portfolio",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "node scripts/sync-legacy.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/sync-legacy.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.*",
    "test:e2e": "playwright test",
    "inventory": "python3 scripts/inventory-legacy.py",
    "capture:legacy": "node scripts/capture-legacy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
