{
  "name": "farzine-profile-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint app components lib scripts/*.ts tests next.config.ts playwright*.config.ts proxy.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts/*.ts tests docs CONTEXT.md package.json tsconfig.json next.config.ts playwright*.config.ts biome.json proxy.ts .github",
    "format:check": "prettier --check app components lib scripts/*.ts tests docs CONTEXT.md package.json tsconfig.json next.config.ts playwright*.config.ts biome.json proxy.ts .github",
    "db:types": "node --import tsx scripts/database-types.ts",
    "db:types:check": "node --import tsx scripts/database-types.ts --check",
    "seed:generate": "python3 scripts/seed.py",
    "test:db": "node --import tsx --test tests/unit/database.test.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "type": "module"
}
