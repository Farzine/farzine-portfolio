{
  "name": "farzine-portfolio",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "node scripts/sync-legacy.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/sync-legacy.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.*",
    "test:e2e": "playwright test --grep-invert @admin && npm run test:e2e:admin",
    "test:e2e:admin": "playwright test --grep @admin --project=desktop",
    "test:e2e:admin:local": "node scripts/with-local-supabase.mjs test:e2e:admin",
    "inventory": "python3 scripts/inventory-legacy.py",
    "capture:legacy": "node scripts/capture-legacy.mjs",
    "test:db": "node scripts/test-db.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "seed:import": "node scripts/import-legacy.mjs",
    "dev:local": "node scripts/with-local-supabase.mjs dev",
    "build:local": "node scripts/with-local-supabase.mjs build",
    "test:e2e:local": "node scripts/with-local-supabase.mjs test:e2e",
    "test:fixtures:local": "node scripts/prepare-public-fixture.mjs",
    "test:production-boundary": "node scripts/check-production-boundary.mjs"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
